# GitHub Personal Access Token (可选)
# 不配置则使用匿名访问，限频 60 次/小时；配置后 5000 次/小时
# 获取: https://github.com/settings/tokens (只需 public_repo / 或留空 scope)
GITHUB_TOKEN=

# AI 评分 (可选) — 使用 MiniMax-M2 via OpenAI-compatible endpoint
# 未配置则降级为纯指标展示，AI 卡片自动隐藏
AI_BASE_URL=https://api.minimaxi.com/v1
AI_API_KEY=
AI_MODEL=MiniMax-M2

# 缓存 TTL（秒），同一仓库在窗口内复用结果
CACHE_TTL_SECONDS=600
